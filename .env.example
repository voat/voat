# Voat deployment configuration — COPY THIS FILE TO ".env" AND EDIT IT.
#
#     cp .env.example .env
#
# docker-compose.yml reads .env and passes the values into the containers.
# .env is gitignored — NEVER commit it. Nothing here is a "default that works
# in production": the three values marked REQUIRED must be set by you.

# =========================== REQUIRED ====================================

# PostgreSQL password for the "voat" database user. Pick something long and
# random, e.g.:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Key used to sign/hashed IP addresses and other internal tokens.
# Generate one, e.g.:  openssl rand -hex 32
# (PowerShell: [guid]::NewGuid().ToString("N")+[guid]::NewGuid().ToString("N"))
# Changing this value invalidates previously issued signed values.
VOAT_SIGNING_KEY=

# Your site's public domain. Local Docker: "localhost". VPS: the real domain
# (DNS A/AAAA record must point at the server before first start, or Caddy's
# automatic HTTPS will fail).
VOAT_DOMAIN=localhost

# =========================== DATABASE ====================================

POSTGRES_USER=voat
POSTGRES_DB=voat

# =========================== HTTPS / PROXY ===============================

# Email address for Let's Encrypt expiry notices (recommended on a VPS).
VOAT_ACME_EMAIL=

# "true" when the site is served over HTTPS (VPS). Enables HSTS and marks
# cookies secure. Leave "false" for plain local development.
VOAT_FORCE_HTTPS=false

# Cookie domain. Leave empty unless you serve Voat across subdomains
# (then use ".example.com").
VOAT_COOKIE_DOMAIN=

# =========================== SITE OWNERS ================================

# Accounts allowed to edit the User Agreement and Privacy Policy from the web
# UI (an "Edit" control appears for them on those two pages). Several accounts
# can be listed comma-separated:  VOAT_SITE_OWNERS=admin,otheruser
#
# NOTE: "admin" is the seeded account, and INSTALL.md publishes its default
# password. Change that password before this site is reachable by anyone else.
VOAT_SITE_OWNERS=admin

# =========================== EMAIL =======================================

# SMTP relay used for registration/verification mail. Empty host = local
# only (mail will not actually leave the machine).
VOAT_SMTP_HOST=127.0.0.1
VOAT_SMTP_PORT=0

# Alternatively use SendGrid (its handler is disabled by default):
VOAT_USE_SENDGRID=false
VOAT_SENDGRID_API_KEY=

# Legacy general-purpose email service key (unused by default handlers).
VOAT_EMAIL_SERVICE_KEY=

# =========================== RECAPTCHA (optional) =======================

VOAT_CAPTCHA_ENABLED=false
VOAT_RECAPTCHA_PUBLIC_KEY=
VOAT_RECAPTCHA_PRIVATE_KEY=

# =========================== LEGACY API (optional) ======================
# The pre-2020 Voat REST API is not ported; these keys remain wired for the
# API-key infrastructure and future use.
VOAT_API_PUBLIC_KEY=
VOAT_API_PRIVATE_KEY=

# Azure blob storage connection string (optional; local file storage is used
# for avatars/thumbnails when empty).
VOAT_STORAGE_CONNECTION_STRING=

# ======================= FOR LOCAL (no Docker) DEVELOPMENT ==============
# The app reads .NET configuration keys directly from the environment. When
# running "dotnet run" outside Docker, use the double-underscore form, e.g.:
#
#   export voat__data__connections__0__value="Server=localhost;port=5432;Database=voat;User ID=voat;Password=YOURPASSWORD;Persist Security Info=True;Keepalive=1;"
#   export voat__settings__signingKey="YOUR-SIGNING-KEY"
#
# (Connection indices: 0 = voatUsers, 1 = ReadWrite, 2 = ReadOnly. All three
# can point at the same database, as in the Docker setup.) See INSTALL.md.

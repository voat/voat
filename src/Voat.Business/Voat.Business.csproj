<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Company>Voat, Inc.</Company>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <AssemblyFileVersion>1.0.0.0</AssemblyFileVersion>
    <AssemblyTitle>Voat.Business</AssemblyTitle>
    <AssemblyProduct>Voat.Business</AssemblyProduct>
    <Version>2.0.0</Version>
    <Authors>Voat, Inc.</Authors>
    <Description>Voat Business Library</Description>
    <Copyright>Voat, Inc.</Copyright>
    <RootNamespace>Voat</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;1705;1591,1572,1571,1573,1587,1570</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core shared framework: Identity, Authorization, Http, Routing types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Sendgrid" Version="9.29.3" />
    <!-- Imaging: SkiaSharp (Apache-2.0). ImageSharp 4.x — the line with the
         security fixes — requires a Six Labors license key to build Release. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- Linux native runtime for the Docker image. The NoDependencies variant
         drops fontconfig; only bitmap operations are used here. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\external\Source\ghorsey\OpenGraph-Net\OpenGraph-Net.csproj" />
    <ProjectReference Include="..\external\Source\toptensoftware\MarkdownDeep\MarkdownDeep.csproj" />
    <ProjectReference Include="..\frameworks\Voat.Validation\Voat.Validation.fsproj" />
    <ProjectReference Include="..\Voat.Common\Voat.Common.csproj" />
    <ProjectReference Include="..\Voat.Data\Voat.Data.csproj" />
    <ProjectReference Include="..\Voat.Logging\Voat.Logging.csproj" />
    <ProjectReference Include="..\Voat.RulesEngine\Voat.RulesEngine.csproj" />
    <ProjectReference Include="..\Voat.Voting\Voat.Voting.csproj" />
  </ItemGroup>
</Project>
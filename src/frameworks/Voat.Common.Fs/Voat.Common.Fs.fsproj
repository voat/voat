<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>Voat, Inc.</Authors>
    <Company>Voat, Inc.</Company>
    <Description>Port of the legacy .net 3.5 validation runtime library to modern .NET</Description>
    <Version>2.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ActivePatterns.fs" />
    <Compile Include="LoaderAttribute.fs" />
    <Compile Include="AttributeFinder.fs" />
    <Compile Include="Extensions.fs" />
    <Compile Include="Helper.fs" />
    <Compile Include="Pathed.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>

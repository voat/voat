<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Modernization: the original config pointed at the defunct dotnet.myget.org feed,
       which breaks restore. Use nuget.org. -->
  <packageSources>
    <add key="api.nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
